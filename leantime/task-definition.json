{
  "family": "lks-leantime-app",
  "taskRoleArn": "arn:aws:iam::663861047640:role/ecsTaskExecutionRole",
  "executionRoleArn": "arn:aws:iam::663861047640:role/ecsTaskExecutionRole",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "volumes": [],
  "placementConstraints": [],
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "containerDefinitions": [
    {
      "name": "leantime",
      "image": "leantime/leantime:latest",
      "cpu": 0,
      "essential": true,
      "volumesFrom": [],
      "systemControls": [],
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp"
        }
      ],
      "secrets": [
        {
          "name": "DB_PASSWORD",
          "valueFrom": "/lks/db/password"
        },
        {
          "name": "DB_USERNAME",
          "valueFrom": "/lks/db/username"
        }
      ],
      "environment": [
        {
          "name": "DB_PORT",
          "value": "/lks/db/port"
        },
        {
          "name": "DB_NAME",
          "value": "/lks/db/name"
        },
        {
          "name": "TIMEZONE",
          "value": "Asia/Jakarta"
        },
        {
          "name": "APP_PORT",
          "value": "8080"
        },
        {
          "name": "APP_URL",
          "value": "lks-oss-lb-1750079067.us-east-1.elb.amazonaws.com"
        },
        {
          "name": "DB_HOST",
          "value": "/lks/db/host"
        },
        {
          "name": "SITE_NAME",
          "value": "LKS Leantime"
        }
      ],
      "mountPoints": [
        {
          "sourceVolume": "public-userfiles",
          "containerPath": "/var/www/html/public/userfiles",
          "readOnly": false
        },
        {
          "sourceVolume": "userfiles",
          "containerPath": "/var/www/html/userfiles",
          "readOnly": false
        },
        {
          "sourceVolume": "plugins",
          "containerPath": "/var/www/html/app/Plugins",
          "readOnly": false
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/lks/gatus-app",
          "awslogs-region": "us-east-1",
          "mode": "non-blocking",
          "awslogs-create-group": "true",
          "max-buffer-size": "25m",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
