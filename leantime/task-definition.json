{ 
  "family": " Iks-leantime-app",
  "taskRoleArn": "arn:aws:iam::663861047640:role/ecsTaskExecutionRole",
  "executionRoleArn": "arn:aws:iam::663861047640:role/ecsTaskExecutionRole",
  "networkMode": "awsvpc",
  "requiresCompatibilities": "FARGATE",
  "cpu": "1024",
  "memory": "2048",
  "volumes": [],
  

  "placementConstraints": [],
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "enableFaultInjection": false,

  "containerDefinitions": [
    {
      "name": "leantime",
      "image": "leantime/leantime:latest",
      "cpu": 0,
      "essential": true,
      "volumesFrom": [],
      "systemControls": [],

     
      "portMappings": [
        {
          "container": 8080,
          "host": 8080,
          "protocol": "tcp"
        }
      ],
      "secrets": [
        {
          "name": "LEANTIME_URL",
          "valueFrom": "arn:aws:ssm:us-east-1:663861047640:parameter/leantime-url"
        },
        {
          "name": "LEANTIME_DB_HOST",
          "valueFrom": "arn:aws:ssm:us-east-1:663861047640:parameter/leantime-db-host"
        },
        {
          "name": "LEANTIME_DB_NAME",
          "valueFrom": "arn:aws:ssm:us-east-1:663861047640:parameter/leantime-db-name"
        },
        {
          "name": "LEANTIME_DB_USER",
          "valueFrom": "arn:aws:ssm:us-east-1:663861047640:parameter/leantime-db-user"
        },
        {
          "name": "LEANTIME_DB_PASSWORD",
          "valueFrom": "arn:aws:ssm:us-east-1:663861047640:parameter/leantime-db-password"
        }
      ],
      "environment": [
        {
          "name": "LEANTIME_URL",
          "value": "${LEANTIME_URL}"
        },
        {
          "name": "LEANTIME_DB_HOST",
          "value": "${LEANTIME_DB_HOST}"
        },
        {
          "name": "LEANTIME_DB_NAME",
          "value": "${LEANTIME_DB_NAME}"
        },
        {
          "name": "LEANTIME_DB_USER",
          "value": "${LEANTIME_DB_USER}"
        },
        {
          "name": "LEANTIME_DB_PASSWORD",
          "value": "${LEANTIME_DB_PASSWORD}"
        }
      ],
      "mountPoints": [
        {
          "sourceVolume": "public-userfiles",
          "containerPath": "/var/www/html/public/userfiles",
          "readOnly": false
        },
        {
          "sourceVolume": "userfiles",
          "containerPath": "/var/www/html/userfiles",
          "readOnly": false
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/lks/gatus-app",
          "awslogs-region": "us-east-1",
          "mode": "non-blocking",
          "awslogs-create-group": "true",
          "max-buffer-size": "25m",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
