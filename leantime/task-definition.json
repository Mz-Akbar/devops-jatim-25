{
  "family": "lks-leantime-app",
  "taskRoleArn": "arn:aws:iam::663861047640:role/ecsTaskExecutionRole",
  "executionRoleArn": "arn:aws:iam::663861047640:role/ecsTaskExecutionRole",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "volumes": [
    {
      "name": "public-userfiles",
      "efsVolumeConfiguration": {
        "fileSystemId": "fs-084ba3f781ed76b25",
        "rootDirectory": "/",
        "transitEncryption": "ENABLED",
        "authorizationConfig": {
          "accessPointId": "fsap-09d036eca38436efa",
          "iam": "ENABLED"
        }
      }
    },

    {
      "name": "userfiles",
      "efsVolumeConfiguration": {
        "fileSystemId": "fs-084ba3f781ed76b25",
        "rootDirectory": "/",
        "transitEncryption": "ENABLED",
        "authorizationConfig": {
          "accessPointId": "fsap-0bbcf9bd8544d90f3",
          "iam": "ENABLED"
        }
      }
    },

    {
      "name": "plugins",
      "efsVolumeConfiguration": {
        "fileSystemId": "fs-084ba3f781ed76b25",
        "rootDirectory": "/",
        "transitEncryption": "ENABLED",
        "authorizationConfig": {
          "accessPointId": "fsap-0fe66e7512579b704",
          "iam": "ENABLED"
        }
      }
    }
  ],
  "placementConstraints": [],
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "containerDefinitions": [
    {
      "name": "leantime",
      "image": "leantime/leantime:latest",
      "cpu": 0,
      "essential": true,
      "volumesFrom": [],
      "systemControls": [],
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp"
        }
      ],
      "secrets": [
         {
          "name": "LEAN_DB_DATABASE",
          "valueFrom": "arn:aws:ssm:us-east-1:663861047640:parameter/lks/db/name"
        },
        {
          "name": "LEAN_DB_HOST",
          "valueFrom": "arn:aws:ssm:us-east-1:748381872886:parameter/lks/db/host"
        },
        {
          "name": "LEAN_DB_PASSWORD",
          "valueFrom": "arn:aws:ssm:us-east-1:663861047640:parameter/lks/db/password"
        },
        {
          "name": "LEAN_DB_PORT",
          "valueFrom": "arn:aws:ssm:us-east-1:663861047640:parameter/lks/db/port"
        },
        {
          "name": "LEAN_DB_USER",
          "valueFrom": "arn:aws:ssm:us-east-1:663861047640:parameter/lks/db/username"
        }
      ],
      "environment": [
        {
          "name": "PUID",
          "value": "1000"
        },
        {
          "name": "PIGD",
          "value": "1000"
        },
        {
          "name": "DB_DEBUG",
          "value": "0"
        },  
        {
          "name": "DB_NAME",
          "value": "/lks/db/name"
        },
        {
          "name": "TIMEZONE",
          "value": "Asia/Jakarta"
        },
        {
          "name": "APP_PORT",
          "value": "8080"
        },
        {
          "name": "LEAN_LANGUAGE",
          "value": "en-US"
        },
        {
          "name": "APP_URL",
          "value": "lks-oss-lb-1750079067.us-east-1.elb.amazonaws.com"
        },
        {
          "name": "LEAN_SITENAME",
          "value": "Leantime"
        }
      ],
      "mountPoints": [
        {
          "sourceVolume": "public-userfiles",
          "containerPath": "/var/www/html/public/userfiles",
          "readOnly": false
        },
        {
          "sourceVolume": "userfiles",
          "containerPath": "/var/www/html/userfiles",
          "readOnly": false
        },
        {
          "sourceVolume": "plugins",
          "containerPath": "/var/www/html/app/Plugins",
          "readOnly": false
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/lks/gatus-app",
          "awslogs-region": "us-east-1",
          "mode": "non-blocking",
          "awslogs-create-group": "true",
          "max-buffer-size": "25m",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
