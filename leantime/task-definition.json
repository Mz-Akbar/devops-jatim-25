{
  "family": "lks-leantime-app",
  "taskRoleArn": "arn:aws:iam::011482749954:role/LabRole",
  "executionRoleArn": "arn:aws:iam::011482749954:role/LabRole",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "volumes": [
    {
      "name": "public_userfiles",
      "efsVolumeConfiguration": {
        "fileSystemId": "fs-03c2f704e6ab0632d",
        "rootDirectory": "/",
        "transitEncryption": "ENABLED",
        "authorizationConfig": {
          "accessPointId": "fsap-07192baf915858555",
          "iam": "ENABLED"
        }
      }
    },
    {
      "name": "userfiles",
      "efsVolumeConfiguration": {
        "fileSystemId": "fs-03c2f704e6ab0632d",
        "rootDirectory": "/",
        "transitEncryption": "ENABLED",
        "authorizationConfig": {
          "accessPointId": "fsap-07192baf915858555",
          "iam": "ENABLED"
        }
      }
    },
    {
      "name": "plugins",
      "efsVolumeConfiguration": {
        "fileSystemId": "fs-03c2f704e6ab0632d",
        "rootDirectory": "/",
        "transitEncryption": "ENABLED",
        "authorizationConfig": {
          "accessPointId":"fsap-0f1dfe9cacd5f6fa2",
          "iam": "ENABLED"
        }
      }
    }
  ],

  "placementConstraints": [],
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "enableFaultInjection": false,

  "containerDefinitions": [
    {
      "name": "leantime",
      "image": "leantime/leantime:latest",
      "cpu": 0,
      "essential": true,
      "volumesFrom": [],
      "systemControls": [],

      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp"
        }
      ],
      "secrets": [
        {
          "name": "LEAN_DB_HOST",
          "valueFrom": "arn:aws:ssm:us-east-1:011482749954:parameter/lks/db/host"
        },
        {
          "name": "LEAN_DB_USER",
          "valueFrom": "arn:aws:ssm:us-east-1:011482749954:parameter/lks/db/username"
        },
        {
          "name": "LEAN_DB_PASSWORD",
          "valueFrom": "arn:aws:ssm:us-east-1:011482749954:parameter/lks/db/password"
        },
        {
          "name": "LEAN_DB_DATABASE",
          "valueFrom": "arn:aws:ssm:us-east-1:011482749954:parameter/lks/db/name"
        },
        {
          "name": "LEAN_DB_PORT",
          "valueFrom": "arn:aws:ssm:us-east-1:011482749954:parameter/lks/db/port"
        }
      ],
      "environment": [
        {
          "name": "PUID",
          "value": "1000"
        },
        {
          "name": "PGID",
          "value": "1000"
        },
        {
          "name": "LEAN_DEBUG",
          "value": "0"
        },
        {
          "name": "LEAN_SITENAME",
          "value": "LKS Leantime"
        },
        {
          "name": "LEAN_LANGUAGE",
          "value": "en-US"
        },
        {
          "name": "LEAN_DEFAULT_TIMEZONE",
          "value": "Asia/Jakarta"
        }
      ],
      "mountPoints": [
        {
          "sourceVolume": "public_userfiles",
          "containerPath": "/var/www/html/public/userfiles",
          "readOnly": false
        },
        {
          "sourceVolume": "userfiles",
          "containerPath": "/var/www/html/userfiles",
          "readOnly": false
        },
        {
          "sourceVolume": "plugins",
          "containerPath": "/var/www/html/Plugins",
          "readOnly": false
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/lks/leantime-app",
          "awslogs-region": "us-east-1",
          "mode": "non-blocking",
          "awslogs-create-group": "true",
          "max-buffer-size": "25m",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
