{ 
  "family": " lks-leantime-app",
  "taskRoleArn": "arn:aws:iam::663861047640:role/ecsTaskExecutionRole",
  "executionRoleArn": "arn:aws:iam::663861047640:role/ecsTaskExecutionRole",
  "networkMode": "awsvpc",
  "requiresCompatibilities": "FARGATE",
  "cpu": "1024",
  "memory": "2048",
  "volumes": [],
  

  "placementConstraints": [],
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "enableFaultInjection": false,

  "containerDefinitions": [
    {
      "name": "leantime",
      "image": "leantime/leantime:latest",
      "cpu": 0,
      "essential": true,
      "volumesFrom": [],
      "systemControls": [],

     
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp"
        }
      ],
      "secrets": 
      "environment":
      "mountPoints": [
        {
          "sourceVolume": "public-userfiles",
          "containerPath": "/var/www/html/public/userfiles",
          "readOnly": false
        },
        {
          "sourceVolume": "userfiles",
          "containerPath": "/var/www/html/userfiles",
          "readOnly": false
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/lks/gatus-app",
          "awslogs-region": "us-east-1",
          "mode": "non-blocking",
          "awslogs-create-group": "true",
          "max-buffer-size": "25m",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
